<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.4.0</Version>
    <RepositoryUrl>https://github.com/gluschenko/onnxify</RepositoryUrl>
    <Authors>Alexander Gluschenko</Authors>
    <Copyright>© 2026 Alexander Gluschenko</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>safetensors;dotnet;machine-learning;ai;tensors;tensor-storage;model-weights;metadata;checkpoint;huggingface;torchsharp;pytorch;serialization;zero-copy;weights</PackageTags>
    <Description>Safetensors-focused .NET library for reading metadata, indexing tensor slices, and working with safetensors-backed tensor storage.</Description>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Memory" Version="4.6.3" GeneratePathProperty="true" />
    <PackageReference Include="System.Buffers" Version="4.6.1" GeneratePathProperty="true" />
    <PackageReference Include="System.Text.Json" Version="10.0.9" GeneratePathProperty="true" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591,1573</NoWarn>
    <DocumentationFile>..\Onnxify.Safetensors.xml</DocumentationFile>
  </PropertyGroup>

</Project>
